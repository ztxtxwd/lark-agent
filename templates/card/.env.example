# 飞书 / Lark 应用
LARK_APP_ID=cli_xxx
LARK_APP_SECRET=
# 开放平台域名；飞书用 open.feishu.cn，Lark 国际版用 open.larksuite.com
LARK_DOMAIN=https://open.feishu.cn
# 机器人对外名称，会写进系统提示词；并用于卡片水印
LARK_BOT_NAME=Lark Agent
# 卡片水印链接（「Generated by <名称>」中的跳转 URL）
LARK_BOT_URL=https://applink.feishu.cn/T99T2TUlBVZx

# OpenAI 兼容模型（任意网关：OpenAI / OpenRouter / DeepSeek / 自建 vLLM …）
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
LLM_API_KEY=

# 上下文
LARK_HISTORY_LIMIT=30
STALE_MESSAGE_THRESHOLD_MS=300000

# Langfuse（可选）
LANGFUSE_TRACING=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# LangSmith（可选）
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=lark-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
